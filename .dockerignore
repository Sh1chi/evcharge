# Всё, что перечислено здесь, не попадает в "контекст сборки" -
# набор файлов, который Docker-клиент отправляет демону перед сборкой образа.
# Чем меньше контекст, тем быстрее сборка и тем меньше шансов случайно
# затащить в образ лишнее (ключи, заметки, чужие бинарники).

.git/
.gitignore
.idea/
.vscode/

# Описание проекта в образе не нужно
README.md

# Локальные бинарники и секреты
bin/
*.exe
.env
.env.local

# Данные томов
.data/
